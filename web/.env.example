# Origin of the oneOps / helpdesk API. No version segment — the app adds /api/v1 itself.
VITE_API_URL=http://localhost:8080

# Mailroom mailbox API (personal mail). Local extract runs on :8083.
VITE_MAILROOM_API_URL=http://localhost:8083

# Issuer origin of Prabhix Identity. Mailroom has no password form, so with this blank there is nowhere
# to sign in and the app says so instead of showing an empty screen.
#
# Local: http://localhost:8081
# Production: https://api.prabhixtechnologies.com  (until identity moves to its own hostname)
VITE_IDENTITY_ISSUER=http://localhost:8081

# Where the "OneOps" link in the header goes. Blank hides the link.
VITE_ONEOPS_URL=http://localhost:5173

# Break-glass IMAP file. Empty in git; a leftover hash here would keep working after
# the console revoked the mailbox password (Dovecot falls through to this passdb).
mail-server/dovecot/bootstrap.passwd

# --- Android ---
# Machine-specific SDK path; every developer's differs.
local.properties
.gradle/
.cxx/
captures/
*.apk
*.aab
*.jks
*.keystore
!debug.keystore
# Release signing: holds the keystore passwords in cleartext. Losing the keystore means never being
# able to update the app for existing installs or on Play, so it belongs in a password manager or a
# secret store — not here, and not in git.
keystore.properties

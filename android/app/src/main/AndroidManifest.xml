<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      AppAuth's RedirectUriReceiverActivity is contributed by the library's own manifest, filtering on
      the ${appAuthRedirectScheme} placeholder that app/build.gradle.kts sets per variant. It is
      deliberately not declared here: two declarations of the same activity is a manifest merge
      conflict, and the library's version is the one that knows how to resume the flow.

      No POST_NOTIFICATIONS and no push. New mail arriving is worth a notification and this app will
      want one, but the platform's push tokens are registered per device for the operator apps'
      conversation and thread notifications; wiring Mailroom into that is its own piece of work rather
      than a permission declared in advance and never used.
    -->
    <application
        android:name=".MailroomApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrabhixMailroom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
